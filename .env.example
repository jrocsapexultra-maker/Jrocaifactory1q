# JROCAI Factory — self-hosted / local-first runtime
# No paid API keys are required for the default path.

# Database (optional for preview; recommended for production)
DATABASE_URL=postgresql://jrocai:jrocai@127.0.0.1:5432/jrocai

# Local text inference
OLLAMA_URL=http://127.0.0.1:11434
# Comma-separated Ollama model tags. The app also discovers installed models automatically.
OLLAMA_MODELS=qwen2.5:7b-instruct

# Local image inference
COMFYUI_URL=http://127.0.0.1:8188
# Comma-separated ComfyUI checkpoint filenames.
COMFYUI_CHECKPOINTS=sd_xl_base_1.0.safetensors
COMFYUI_TIMEOUT_MS=180000
COMFYUI_STEPS=24
COMFYUI_CFG=6.5

# Strict local mode by default. Set true only when intentionally using a remote fallback.
ENABLE_REMOTE_FALLBACK=false

# Hard disabled: there is no mock-image/mockup renderer in production.
MOCKUP_MODE=false
